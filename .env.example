# AI Finance Officer - Environment Variables Example
# Copy this file to .env and fill in your actual values
# NEVER commit your actual .env file to version control

# ============================================
# Backend Secrets
# ============================================

# Anthropic API Key for AI chat functionality
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@host:5432/database

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Session Security
SESSION_SECRET=generate_a_secure_random_string

# Alpha Vantage API for Market Data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Node Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=5000

# ============================================
# Frontend Environment Variables (VITE_ prefix required)
# ============================================

# API Base URL
# For local development: leave empty (uses relative URLs for same-origin requests)
# For production with separate frontend/backend: https://api.aifinanceofficer.com
VITE_API_BASE_URL=

# WebSocket URL for market data
# For local development: leave empty (uses relative ws:// based on window.location)
# For production with separate frontend/backend: wss://api.aifinanceofficer.com/ws/market
VITE_WS_URL=

# Supabase Configuration (frontend-safe keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
